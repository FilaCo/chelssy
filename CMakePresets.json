{
  "version": 6,
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host: Debug + ASan/UBSan + tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CHELSSY_TESTING": "ON",
        "CHELSSY_ASAN": "ON"
      }
    },
    {
      "name": "host-coverage",
      "displayName": "Host: Debug + tests + coverage reports",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHELSSY_TESTING": "ON",
        "CHELSSY_COVERAGE": "ON"
      }
    },
    {
      "name": "fuzz-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CHELSSY_TESTING": "ON",
        "CHELSSY_ASAN": "ON",
        "CHELSSY_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-coverage-run",
      "configurePreset": "host-coverage",
      "targets": ["ccov-all-run"]
    },
    {
      "name": "host-coverage-report",
      "configurePreset": "host-coverage",
      "targets": ["ccov-all", "ccov-all-report"]
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "check",
      "displayName": "Configure + build + run unit tests",
      "steps": [
        {
          "type": "configure",
          "name": "host-debug"
        },
        {
          "type": "build",
          "name": "host-debug"
        },
        {
          "type": "test",
          "name": "host-debug"
        }
      ]
    },
    {
      "name": "coverage",
      "displayName": "Configure + run tests + generate coverage report",
      "steps": [
        {
          "type": "configure",
          "name": "host-coverage"
        },
        {
          "type": "build",
          "name": "host-coverage-run"
        },
        {
          "type": "build",
          "name": "host-coverage-report"
        }
      ]
    }
  ]
}
