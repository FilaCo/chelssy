{
  "version": 6,
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host: Debug + ASan/UBSan + tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CHELSSY_TESTING": "ON",
        "CHELSSY_ASAN": "ON"
      }
    },
    {
      "name": "fuzz-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CHELSSY_TESTING": "ON",
        "CHELSSY_ASAN": "ON",
        "CHELSSY_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "check",
      "displayName": "Configure + build + run unit tests",
      "steps": [
        {
          "type": "configure",
          "name": "host-debug"
        },
        {
          "type": "build",
          "name": "host-debug"
        },
        {
          "type": "test",
          "name": "host-debug"
        }
      ]
    }
  ]
}